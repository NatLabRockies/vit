# Dockerfile for vit-dev-openfast — VIT development container for the OpenFAST / AeroDyn
# translation effort.
#
# PURPOSE
# -------
# This container is separate from vit-dev (the ROSCO container) because OpenFAST has build
# dependencies that ROSCO doesn't need:
#
#   - LAPACK / BLAS (OpenFAST uses linear algebra extensively in ElastoDyn, SubDyn, BeamDyn)
#   - CMake 3.15+ (OpenFAST's minimum; ROSCO only needed 3.6+)
#   - yaml-cpp (newer OpenFAST modules use it for some config parsing)
#   - Python packages for the reg_tests/ framework (vtk, Bokeh, nptdms, pandas — beyond what
#     ROSCO's vit_sim.py needed)
#   - fparser2 (VIT's structural inventory step, used during PROJECT_PLAN_AERODYN.md drafting
#     per the methodology in CREATING_PROJECT_PLANS.md)
#
# Layering these on top of vit-dev risks breaking the known-good ROSCO environment. The
# separate-container approach isolates that risk. See dev note 202604140204-vit-dev-openfast-docker-plan.md
# for the full decision rationale.
#
# BASE IMAGE
# ----------
# We FROM the committed vit-dev-image rather than ubuntu:24.04 because vit-dev-image already
# contains everything needed for the VIT/KGen toolchain: Ubuntu 24.04 (ARM), gfortran, g++,
# cmake (TODO: verify version), Python 3.12, Python 2.7 built from source at /opt/python27,
# KGen installed, and VIT's Python dependencies. Starting from there means we only need to
# install OpenFAST-specific deltas, which minimizes the network footprint during `docker build`.
#
# Before building, the base image must be loaded from its tarball (if not already loaded):
#
#     docker load < vit-dev-image.tar.gz
#
# BUILD
# -----
#     cd vit_translation_openfast/vit/docker
#     docker build -f Dockerfile.openfast -t vit-dev-openfast ..
#
# (Note the `..` — build context is the parent vit/ directory, not the docker/ subdirectory,
# in case we want to COPY things from vit/ in future revisions of this Dockerfile.)
#
# RUN
# ---
#     docker run -d --name vit-dev-openfast \
#         -v ~/vit_translation_openfast:/workspace \
#         vit-dev-openfast
#
# The mount puts the OpenFAST workspace at /workspace/ inside the container, so:
#     /workspace/vit/           <- VIT tool (independent clone on main)
#     /workspace/KGen/          <- KGen (independent clone on master)
#     /workspace/openfast/      <- OpenFAST source tree
#
# NETWORK ACCESS NOTE
# -------------------
# The original vit-dev container was built interactively, NOT from a Dockerfile, because at
# that time corporate TLS inspection was thought to block apt/pip network access during
# `docker build`. See dev note 202603231054-collaborator-onboarding.md.
#
# **Verified working 2026-04-14:** this Dockerfile builds successfully end-to-end with full
# network access during `docker build` on the Mac host — apt packages, pip packages, and the
# Python 2.7 source tarball download all succeed. The TLS-inspection concern that motivated
# the original interactive-build approach does not appear to apply to `docker build` in the
# current environment. Dev note 202604140204 records the full build and smoke-test results.
#
# **Fallback if network access fails in the future:** the same interactive pattern that built
# the original vit-dev still works as a fallback:
#   1. docker run --name vit-dev-openfast-setup -it vit-dev-image bash
#   2. Inside the running container, run each RUN step below manually (possibly after
#      temporarily disabling TLS inspection, or from a different network such as home or VPN)
#   3. docker commit vit-dev-openfast-setup vit-dev-openfast
#   4. docker rm vit-dev-openfast-setup

FROM vit-dev-image

# -----------------------------------------------------------------------------
# OpenFAST build dependencies (system packages via apt)
# -----------------------------------------------------------------------------

# libopenblas-dev + liblapack-dev: OpenFAST's linear-algebra backbone. Required by
# ElastoDyn (mode shapes, eigenvalue problems), SubDyn (Craig-Bampton reduction),
# BeamDyn (structural dynamics), and others. AeroDyn itself uses them indirectly
# through its BEMT and DBEMT sub-modules.
#
# libyaml-cpp-dev: newer OpenFAST versions use yaml-cpp for some config parsing.
# AeroDyn-specific requirement TBD — may not be strictly needed for AeroDyn alone,
# but installing it cheaply pre-empts a later rebuild if it turns out to be needed.
#
# cmake is NOT installed here — verified that vit-dev-image has cmake 3.28.3, which
# comfortably exceeds OpenFAST's 3.15 minimum. gfortran 13.3.0 and Python 3.12.3 are
# also already present, so no toolchain reinstall needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas-dev \
        liblapack-dev \
        libyaml-cpp-dev \
    && rm -rf /var/lib/apt/lists/*

# Optional: HDF5 for reg_tests output. Commented out — enable if needed later.
# RUN apt-get update && apt-get install -y --no-install-recommends libhdf5-dev \
#     && rm -rf /var/lib/apt/lists/*

# Optional: NetCDF for reg_tests output. Commented out — enable if needed later.
# RUN apt-get update && apt-get install -y --no-install-recommends libnetcdf-dev \
#     && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Python 2.7 (required by KGen)
# -----------------------------------------------------------------------------
#
# KGen — the state-capture tool VIT wraps — is written in Python 2.7 and must be
# run with a Python 2.7 interpreter. The vit-dev-image base has a symlink at
# /usr/local/bin/python2.7 pointing at /opt/python27/bin/python2.7, but the target
# directory was not captured when the image was committed — the symlink is dangling.
# We rebuild Python 2.7 from source here so the OpenFAST container has a working
# KGen toolchain out of the box, matching the ROSCO container's (manually-built) setup.
#
# The build adds ~5-10 minutes to docker build time. If you're iterating on the
# Dockerfile and don't need KGen yet (e.g., during Phase 0 structural inventory work
# with fparser, which is pure Python 3), you can temporarily comment out the two
# RUN blocks below.

# Build-time development headers for Python 2.7's optional modules.
# wget is pulled in to fetch the tarball from python.org. build-essential covers
# the compiler toolchain (gcc, make, etc.) and should mostly be a no-op since
# g++ + gfortran are already present, but pulling it in is explicit.
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        build-essential \
        libssl-dev \
        zlib1g-dev \
        libffi-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://www.python.org/ftp/python/2.7.18/Python-2.7.18.tar.xz \
        -O /tmp/Python-2.7.18.tar.xz \
    && cd /tmp && tar -xf Python-2.7.18.tar.xz \
    && cd Python-2.7.18 \
    && ./configure --prefix=/opt/python27 \
    && make -j$(nproc) \
    && make install \
    && ln -sf /opt/python27/bin/python2.7 /usr/local/bin/python2.7 \
    && cd / && rm -rf /tmp/Python-2.7.18*

# -----------------------------------------------------------------------------
# VIT analysis dependencies (pip)
# -----------------------------------------------------------------------------

# fparser: the Fortran AST toolkit from STFC's PSyclone project. Used by VIT's
# structural inventory step (Phase 0 of CREATING_PROJECT_PLANS.md methodology) to
# produce the function/call-graph/type/module data that informs PROJECT_PLAN_AERODYN.md.
#
# Installed package name is `fparser` (not `fparser2`). The `fparser2` module is a
# submodule of the `fparser` package — `from fparser.two.parser import ParserFactory`.
RUN pip3 install --break-system-packages fparser

# -----------------------------------------------------------------------------
# OpenFAST regression test framework dependencies (pip)
# -----------------------------------------------------------------------------

# From openfast/requirements.txt:
#   numpy vtk Bokeh>=2.4,!=3.0.0,!=3.0.1,!=3.0.2,!=3.0.3 pytest nptdms pandas
#
# vit-dev-image already has numpy (2.4.2), pandas (3.0.1), pytest (9.0.2), and scipy
# (1.17.1) — four of the commonly-needed Python deps carry over from the ROSCO image.
# We only need to install the three missing ones (vtk, Bokeh, nptdms) for OpenFAST's
# reg_tests framework.
#
# If we end up not using reg_tests for AeroDyn verification (e.g., if we use a custom
# AeroDyn Driver-based harness instead), these packages are harmless overhead — they
# don't conflict with anything VIT or KGen need.
RUN pip3 install --break-system-packages \
        vtk \
        'Bokeh>=2.4,!=3.0.0,!=3.0.1,!=3.0.2,!=3.0.3' \
        nptdms

# -----------------------------------------------------------------------------
# Workspace and editable installs
# -----------------------------------------------------------------------------

# The mount point. Matches the vit-dev convention.
WORKDIR /workspace

# NOTE: vit-dev-image has VIT and ROSCO installed as editable packages pointing at
# /workspace/vit and /workspace/ROSCO. Those paths are for the ROSCO workspace. In the
# OpenFAST workspace mount, /workspace/vit points at the NEW VIT clone (same main branch,
# independent working directory), and /workspace/ROSCO doesn't exist — instead,
# /workspace/openfast/ is the translation target.
#
# The editable installs inherited from the base image will break on first run because
# they point at paths that don't exist in the OpenFAST mount. The fix is to re-run
# `pip install -e` after the container is mounted:
#
#     docker exec vit-dev-openfast pip3 install -e /workspace/vit --break-system-packages
#
# This is the same workaround CLAUDE.md documents for vit-dev after mounting a fresh
# workspace. We cannot do it in the Dockerfile itself because /workspace/vit doesn't
# exist at build time (it's populated at run time from the bind mount).

# -----------------------------------------------------------------------------
# Default command
# -----------------------------------------------------------------------------

# Keep the container running so `docker exec -it vit-dev-openfast bash` can attach.
CMD ["sleep", "infinity"]
